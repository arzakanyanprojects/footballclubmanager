{
  "name": "fcmanager",
  "version": "1.4.0",
  "description": "Football club student management: students, payments, attendance and contracts",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never",
    "release": "vite build && electron-builder --win --publish always"
  },
  "author": "FC Manager",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "docxtemplater": "^3.71.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.67.0",
    "nodemailer": "^7.0.13",
    "pizzip": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "productName": "FC Manager",
  "build": {
    "appId": "com.fcmanager.app",
    "productName": "FC Manager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FC Manager",
      "artifactName": "FC-Manager-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arzakanyanprojects",
        "repo": "footballclubmanager"
      }
    ]
  },
  "repository": "github:arzakanyanprojects/footballclubmanager"
}
